# Web UI: Use SolidStart UI instead of Datastar (requires webui build)
# WEB_UI_SOLID=false

# Network discovery
# Set to true to allow discovery admin actions from loopback/private LAN
# without WEB_UI_USER/WEB_UI_PASS. Also permits WEB_UI_HOST=0.0.0.0
# without Basic Auth so peers can reach discovery endpoints. Only use this
# on a trusted private LAN.
DISCOVERY_TRUST_LAN_ADMIN=false

# Firebase (for agents needing Firebase access)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Google Cloud
# GOOGLE_APPLICATION_CREDENTIALS=
# GCLOUD_PROJECT=

# Container lifecycle
# Defaults to 0 so idle message containers exit and future messages resume the session.
# Increase to keep a warm idle pool for lower first-token latency.
# MAX_IDLE_CONTAINERS=0

# Shared Claude VM: consolidate all Claude agent-runner processes into a single
# long-running Apple Container VM. Each agent runs via `container exec` into
# the shared VM.
# Reduces disk usage from 2N to N+1 containers. Apple Container only.
# SHARED_CLAUDE_VM=false
# SHARED_CLAUDE_VM_MEMORY=16G

# GitHub webhook listener
# Set a shared secret when exposing /webhooks/github.
# GITHUB_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_PORT=3001
# GITHUB_WEBHOOK_PATH=/webhooks/github
# Max bytes accepted before rejecting a webhook with HTTP 413.
# GITHUB_WEBHOOK_MAX_BODY_BYTES=262144

# Cursor Agents SDK backend — set backend: cursor-sdk on an agent (agents.yaml / registrations).
# Requires @cursor/sdk (bundled dependency). Uses session storage like container runs for continuity.
# CURSOR_API_KEY=
# Optional model id for local agents (see Cursor.models.list(); default composer-2).
# CURSOR_AGENT_MODEL=composer-2
# Optional cloud mode: JSON array of repos, e.g. [{"url":"https://github.com/org/repo"}].
# When set, agents run as Cursor cloud agents against clones instead of local cwd.
# CURSOR_AGENT_CLOUD_REPOS=
# CURSOR_CLOUD_SKIP_REVIEWER_REQUEST=true

# Declarative agent topology
# Defaults to agents.yaml in the project root. Loading is opt-in by file
# existence. Set to another relative or absolute path to load agent/channel
# registrations from versioned config at startup.
# AGENTS_CONFIG_PATH=agents.yaml
