{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": ["bun-types"],
    "paths": {
      "@omniclaw/protocol": ["../../packages/protocol/src/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
